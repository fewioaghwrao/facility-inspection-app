<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FacilityInspection.ViewModels"
    x:Class="FacilityInspection.Views.NotStartedListView"
    x:DataType="vm:NotStartedListViewModel"
    Background="#F3F6FA">

    <UserControl.Styles>

        <!-- カード -->
        <Style Selector="Border.scheduleCard">
            <Setter Property="Background"
                    Value="#FFFFFF" />
            <Setter Property="BorderBrush"
                    Value="#E2E8F0" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="CornerRadius"
                    Value="12" />
            <Setter Property="Padding"
                    Value="18" />
            <Setter Property="Margin"
                    Value="0,0,0,12" />
        </Style>

        <!-- 詳細 -->
        <Style Selector="Button.detailButton">
            <Setter Property="MinWidth"
                    Value="76" />
            <Setter Property="Height"
                    Value="36" />
            <Setter Property="Padding"
                    Value="14,0" />
            <Setter Property="Background"
                    Value="#EFF6FF" />
            <Setter Property="Foreground"
                    Value="#1D4ED8" />
            <Setter Property="BorderBrush"
                    Value="#BFDBFE" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="CornerRadius"
                    Value="7" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Center" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
        </Style>

        <Style Selector="Button.detailButton:pointerover">
            <Setter Property="Background"
                    Value="#DBEAFE" />
        </Style>

        <!-- ページング -->
        <Style Selector="Button.pageButton">
            <Setter Property="MinWidth"
                    Value="86" />
            <Setter Property="Height"
                    Value="38" />
            <Setter Property="Padding"
                    Value="14,0" />
            <Setter Property="Background"
                    Value="#FFFFFF" />
            <Setter Property="Foreground"
                    Value="#334155" />
            <Setter Property="BorderBrush"
                    Value="#CBD5E1" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="CornerRadius"
                    Value="7" />
        </Style>

    </UserControl.Styles>


    <Grid
        RowDefinitions="Auto,Auto,*,Auto">

        <!-- ========================================
             Header
             ======================================== -->

        <Border
            Grid.Row="0"
            Padding="24,20"
            Background="#FFFFFF"
            BorderBrush="#E2E8F0"
            BorderThickness="0,0,0,1">

            <Grid
                ColumnDefinitions="*,Auto"
                ColumnSpacing="16">

                <StackPanel
                    Grid.Column="0"
                    Spacing="5">

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="10">

                        <TextBlock
                            Text="{Binding Title}"
                            FontSize="25"
                            FontWeight="Bold"
                            Foreground="#0F172A"
                            VerticalAlignment="Center" />

                        <!-- 件数 -->
                        <Border
                            Padding="10,4"
                            Background="#FEF3C7"
                            CornerRadius="12"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="{Binding CountText}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#92400E" />

                        </Border>

                    </StackPanel>

                    <TextBlock
                        Text="{Binding Description}"
                        FontSize="13"
                        Foreground="#64748B"
                        TextWrapping="Wrap" />

                </StackPanel>


                <Button
                    Grid.Column="1"
                    Content="再読み込み"
                    Command="{Binding LoadCommand}"
                    MinWidth="100"
                    Height="38"
                    Padding="14,0"
                    VerticalAlignment="Center"
                    Background="#FFFFFF"
                    Foreground="#334155"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="7" />

            </Grid>

        </Border>


        <!-- ========================================
             Search
             ======================================== -->

        <Border
            Grid.Row="1"
            Margin="24,18,24,12"
            Padding="16"
            Background="#FFFFFF"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="10">

            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="12">

                <TextBlock
                    Grid.Column="0"
                    Text="検索"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#475569"
                    VerticalAlignment="Center" />

                <TextBox
                    Grid.Column="1"
                    Text="{Binding SearchText}"
                    Watermark="工場・設置場所・設備コード・設備名・点検票・担当者で検索"
                    MinHeight="38"
                    Padding="10,7"
                    Background="#F8FAFC"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="7" />

            </Grid>

        </Border>


        <!-- ========================================
             Content
             ======================================== -->

        <Grid
            Grid.Row="2"
            Margin="24,0,24,0">

            <!-- ====================================
                 カード一覧
                 ==================================== -->

            <ScrollViewer
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">

                <ItemsControl
                    ItemsSource="{Binding Items}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate
                            x:DataType="vm:NotStartedListItemViewModel">

                            <Border
                                Classes="scheduleCard">

                                <Grid
                                    RowDefinitions="Auto,Auto,Auto"
                                    RowSpacing="14">

                                    <!-- ============================
                                         Header
                                         ============================ -->

                                    <Grid
                                        Grid.Row="0"
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="16">

                                        <StackPanel
                                            Grid.Column="0"
                                            Spacing="5">

                                            <!-- 設備 -->
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="8">

                                                <TextBlock
                                                    Text="{Binding EquipmentCode}"
                                                    FontSize="16"
                                                    FontWeight="Bold"
                                                    Foreground="#0F172A"
                                                    VerticalAlignment="Center" />

                                                <TextBlock
                                                    Text="{Binding EquipmentName}"
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    Foreground="#334155"
                                                    VerticalAlignment="Center"
                                                    TextWrapping="Wrap" />

                                            </StackPanel>

                                            <!-- 場所 -->
                                            <TextBlock
                                                Text="{Binding LocationDisplayName}"
                                                FontSize="12"
                                                Foreground="#64748B"
                                                TextWrapping="Wrap" />

                                        </StackPanel>


                                        <!-- 日付 / 状態 -->
                                        <StackPanel
                                            Grid.Column="1"
                                            Spacing="7"
                                            HorizontalAlignment="Right">

                                            <TextBlock
                                                Text="{Binding ScheduledDateText}"
                                                FontSize="12"
                                                Foreground="#64748B"
                                                HorizontalAlignment="Right" />

                                            <Border
                                                Padding="10,4"
                                                Background="#FEF3C7"
                                                CornerRadius="12"
                                                HorizontalAlignment="Right">

                                                <TextBlock
                                                    Text="{Binding StatusText}"
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                    Foreground="#92400E" />

                                            </Border>

                                        </StackPanel>

                                    </Grid>


                                    <!-- ============================
                                         点検票
                                         ============================ -->

                                    <Border
                                        Grid.Row="1"
                                        Padding="14"
                                        Background="#F8FAFC"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="9">

                                        <StackPanel
                                            Spacing="5">

                                            <TextBlock
                                                Text="点検票"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="#64748B" />

                                            <TextBlock
                                                Text="{Binding TemplateName}"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="#334155"
                                                TextWrapping="Wrap" />

                                        </StackPanel>

                                    </Border>


                                    <!-- ============================
                                         Footer
                                         ============================ -->

                                    <Grid
                                        Grid.Row="2"
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="16">

                                        <!-- 担当者 -->
                                        <StackPanel
                                            Grid.Column="0"
                                            Orientation="Horizontal"
                                            Spacing="7"
                                            VerticalAlignment="Center">

                                            <TextBlock
                                                Text="担当者"
                                                FontSize="11"
                                                Foreground="#94A3B8"
                                                VerticalAlignment="Center" />

                                            <TextBlock
                                                Text="{Binding OperatorName}"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="#475569"
                                                VerticalAlignment="Center" />

                                        </StackPanel>


                                        <!-- 詳細 -->
                                        <Button
                                            Grid.Column="1"
                                            Classes="detailButton"
                                            Content="詳細"
                                            Command="{Binding OpenDetailCommand}"
                                            VerticalAlignment="Center" />

                                    </Grid>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>


            <!-- ====================================
                 Loading
                 ==================================== -->

            <Border
                IsVisible="{Binding IsLoading}"
                Background="#88F3F6FA"
                ZIndex="10">

                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">

                    <ProgressBar
                        Width="180"
                        Height="6"
                        IsIndeterminate="True" />

                    <TextBlock
                        Text="未実施データを読み込んでいます..."
                        FontSize="13"
                        Foreground="#64748B"
                        HorizontalAlignment="Center" />

                </StackPanel>

            </Border>


            <!-- ====================================
                 Empty
                 ==================================== -->

            <Border
                IsVisible="{Binding IsEmpty}"
                Padding="30"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="12"
                VerticalAlignment="Top">

                <StackPanel
                    HorizontalAlignment="Center"
                    Spacing="8">

                    <TextBlock
                        Text="✓"
                        FontSize="32"
                        FontWeight="Bold"
                        Foreground="#16A34A"
                        HorizontalAlignment="Center" />

                    <TextBlock
                        Text="該当する未実施予定はありません"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#334155"
                        HorizontalAlignment="Center" />

                    <TextBlock
                        Text="検索条件を変更するか、点検予定を確認してください。"
                        FontSize="12"
                        Foreground="#64748B"
                        HorizontalAlignment="Center" />

                </StackPanel>

            </Border>


            <!-- ====================================
                 Error
                 ==================================== -->

            <Border
                IsVisible="{Binding HasError}"
                Padding="16"
                Background="#FEF2F2"
                BorderBrush="#FECACA"
                BorderThickness="1"
                CornerRadius="9"
                VerticalAlignment="Top"
                ZIndex="20">

                <TextBlock
                    Text="{Binding ErrorMessage}"
                    Foreground="#B91C1C"
                    FontSize="12"
                    TextWrapping="Wrap" />

            </Border>

        </Grid>


        <!-- ========================================
             Pagination
             ======================================== -->

        <Border
            Grid.Row="3"
            Margin="24,12,24,18"
            Padding="14"
            Background="#FFFFFF"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="10">

            <Grid
                ColumnDefinitions="*,Auto,*"
                ColumnSpacing="14">

                <Button
                    Grid.Column="0"
                    Classes="pageButton"
                    Content="← 前へ"
                    Command="{Binding PreviousPageCommand}"
                    IsEnabled="{Binding HasPreviousPage}"
                    HorizontalAlignment="Right" />

                <TextBlock
                    Grid.Column="1"
                    Text="{Binding PageText}"
                    MinWidth="70"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#475569"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    TextAlignment="Center" />

                <Button
                    Grid.Column="2"
                    Classes="pageButton"
                    Content="次へ →"
                    Command="{Binding NextPageCommand}"
                    IsEnabled="{Binding HasNextPage}"
                    HorizontalAlignment="Left" />

            </Grid>

        </Border>

    </Grid>

</UserControl>