<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FacilityInspection.ViewModels"
    x:Class="FacilityInspection.Views.InspectionStatusView"
    x:DataType="vm:InspectionStatusViewModel"
    Background="#F3F6FA">

    <Grid
        Margin="28"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="18">

        <!-- 画面タイトル -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto">

            <StackPanel
                Grid.Column="0"
                Spacing="5">

                <TextBlock
                    Text="{Binding Title}"
                    FontSize="26"
                    FontWeight="Bold"
                    Foreground="#0F172A" />

                <TextBlock
                    Text="{Binding Description}"
                    FontSize="13"
                    Foreground="#64748B" />

            </StackPanel>

            <Button
                Grid.Column="1"
                MinWidth="100"
                Height="40"
                Padding="18,0"
                Content="再読み込み"
                Command="{Binding LoadCommand}"
                HorizontalContentAlignment="Center"
                Background="#FFFFFF"
                Foreground="#334155"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="8" />

        </Grid>

        <!-- 検索・状態フィルター -->
        <Border
            Grid.Row="1"
            Padding="18"
            Background="#FFFFFF"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="12">

            <Grid
                ColumnDefinitions="*,220,Auto"
                ColumnSpacing="12">

                <TextBox
                    Grid.Column="0"
                    Height="40"
                    Padding="12,0"
                    Text="{Binding SearchText}"
                    Watermark="設備コード、設備名、担当者などで検索" />

                <ComboBox
                    Grid.Column="1"
                    Height="40"
                    ItemsSource="{Binding StatusFilters}"
                    SelectedItem="{Binding SelectedStatusFilter}">

                    <ComboBox.ItemTemplate>
                        <DataTemplate
                            x:DataType="vm:InspectionStatusFilterOptionViewModel">

                            <TextBlock
                                Text="{Binding DisplayName}" />

                        </DataTemplate>
                    </ComboBox.ItemTemplate>

                </ComboBox>

                <Border
                    Grid.Column="2"
                    MinWidth="72"
                    Padding="14,8"
                    Background="#EFF6FF"
                    CornerRadius="8">

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="{Binding CountText}"
                        FontWeight="SemiBold"
                        Foreground="#1D4ED8" />

                </Border>

            </Grid>

        </Border>

        <!-- エラー表示 -->
        <Border
            Grid.Row="2"
            IsVisible="{Binding HasError}"
            Padding="14"
            Background="#FEF2F2"
            BorderBrush="#FECACA"
            BorderThickness="1"
            CornerRadius="8">

            <TextBlock
                Text="{Binding ErrorMessage}"
                TextWrapping="Wrap"
                Foreground="#B91C1C" />

        </Border>

        <!-- 一覧 -->
        <Grid Grid.Row="3">

            <ScrollViewer
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">

                <StackPanel
                    MinWidth="1130"
                    Spacing="8">

                    <!-- ヘッダー -->
                    <Border
                        Padding="14,11"
                        Background="#E2E8F0"
                        CornerRadius="8">

                        <Grid
                            ColumnDefinitions="100,180,220,170,130,125,90,90"
                            ColumnSpacing="10">

                            <TextBlock
                                Grid.Column="0"
                                Text="予定日"
                                FontWeight="SemiBold"
                                Foreground="#475569" />

                            <TextBlock
                                Grid.Column="1"
                                Text="工場・設置場所"
                                FontWeight="SemiBold"
                                Foreground="#475569" />

                            <TextBlock
                                Grid.Column="2"
                                Text="設備"
                                FontWeight="SemiBold"
                                Foreground="#475569" />

                            <TextBlock
                                Grid.Column="3"
                                Text="点検票"
                                FontWeight="SemiBold"
                                Foreground="#475569" />

                            <TextBlock
                                Grid.Column="4"
                                Text="担当者"
                                FontWeight="SemiBold"
                                Foreground="#475569" />

                            <TextBlock
                                Grid.Column="5"
                                Text="状態"
                                FontWeight="SemiBold"
                                Foreground="#475569" />

                            <TextBlock
                                Grid.Column="6"
                                Text="異常"
                                FontWeight="SemiBold"
                                Foreground="#475569" />

                            <TextBlock
                                Grid.Column="7"
                                Text="写真"
                                FontWeight="SemiBold"
                                Foreground="#475569" />

                        </Grid>

                    </Border>

                    <ItemsControl ItemsSource="{Binding Items}">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate
                                x:DataType="vm:InspectionStatusListItemViewModel">

                                <Border
                                    Margin="0,0,0,7"
                                    Padding="14"
                                    Background="#FFFFFF"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="10">

                                    <Grid
                                        ColumnDefinitions="100,180,220,170,130,125,90,90"
                                        ColumnSpacing="10">

                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Text="{Binding ScheduledDateText}"
                                            Foreground="#334155" />

                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Text="{Binding LocationDisplayName}"
                                            TextWrapping="Wrap"
                                            Foreground="#334155" />

                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Text="{Binding EquipmentDisplayName}"
                                            TextWrapping="Wrap"
                                            FontWeight="SemiBold"
                                            Foreground="#0F172A" />

                                        <TextBlock
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            Text="{Binding TemplateName}"
                                            TextWrapping="Wrap"
                                            Foreground="#475569" />

                                        <TextBlock
                                            Grid.Column="4"
                                            VerticalAlignment="Center"
                                            Text="{Binding OperatorName}"
                                            TextWrapping="Wrap"
                                            Foreground="#475569" />

                                        <Border
                                            Grid.Column="5"
                                            Padding="10,6"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="{Binding StatusBackground}"
                                            CornerRadius="12">

                                            <TextBlock
                                                Text="{Binding StatusText}"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{Binding StatusForeground}" />

                                        </Border>

                                        <Border
                                            Grid.Column="6"
                                            Padding="8,6"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="{Binding AbnormalBackground}"
                                            CornerRadius="12">

                                            <TextBlock
                                                Text="{Binding AbnormalCountText}"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{Binding AbnormalForeground}" />

                                        </Border>

                                        <StackPanel
                                            Grid.Column="7"
                                            VerticalAlignment="Center"
                                            Spacing="2">

                                            <TextBlock
                                                Text="{Binding PhotoCountText}"
                                                FontWeight="SemiBold"
                                                Foreground="#334155" />

                                            <TextBlock
                                                Text="{Binding ResultCountText}"
                                                FontSize="11"
                                                Foreground="#94A3B8" />

                                        </StackPanel>

                                    </Grid>

                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </StackPanel>

            </ScrollViewer>

            <!-- 読み込み中 -->
            <Border
                IsVisible="{Binding IsLoading}"
                Background="#CCF8FAFC">

                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">

                    <ProgressBar
                        Width="220"
                        IsIndeterminate="True" />

                    <TextBlock
                        Text="点検実施状況を読み込んでいます..."
                        Foreground="#475569" />

                </StackPanel>

            </Border>

            <!-- 0件 -->
            <Border
                IsVisible="{Binding IsEmpty}"
                Margin="0,52,0,0"
                Padding="36"
                VerticalAlignment="Top"
                Background="#FFFFFF"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="12">

                <StackPanel
                    HorizontalAlignment="Center"
                    Spacing="8">

                    <TextBlock
                        HorizontalAlignment="Center"
                        Text="点検実施データがありません"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="#334155" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        Text="検索条件または状態フィルターを変更してください。"
                        Foreground="#64748B" />

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>