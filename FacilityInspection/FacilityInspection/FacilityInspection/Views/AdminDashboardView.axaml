<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FacilityInspection.ViewModels"
    x:Class="FacilityInspection.Views.AdminDashboardView"
    x:DataType="vm:AdminDashboardViewModel"
    Background="#F3F6FA">

    <UserControl.Styles>

        <Style Selector="Border.summaryCard">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter
                Property="BoxShadow"
                Value="0 4 14 0 #160F172A" />
        </Style>

    </UserControl.Styles>

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">

        <StackPanel
            Margin="28"
            Spacing="22">

            <!-- ここに現在の管理者ダッシュボード本体を残す -->

            <Grid ColumnDefinitions="*,Auto">

                <StackPanel
                    Grid.Column="0"
                    Spacing="5">

                    <TextBlock
                        Text="保全責任者"
                        FontSize="28"
                        FontWeight="Bold"
                        Foreground="#0F172A" />

                    <TextBlock
                        Text="{Binding WelcomeMessage}"
                        FontSize="14"
                        Foreground="#64748B" />

                </StackPanel>

                <Border
                    Grid.Column="1"
                    Padding="14,8"
                    Background="#DBEAFE"
                    CornerRadius="8"
                    VerticalAlignment="Center">

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8">

                        <TextBlock
                            Text="保全責任者"
                            Foreground="#1D4ED8"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Text="{Binding CurrentDateText}"
                            Foreground="#475569" />

                    </StackPanel>

                </Border>

            </Grid>

            <!-- 既存の集計カードと「本日の状況」をこの下に残す -->

        </StackPanel>

    </ScrollViewer>

</UserControl>