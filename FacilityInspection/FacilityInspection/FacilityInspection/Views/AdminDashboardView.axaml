<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FacilityInspection.ViewModels"
    x:Class="FacilityInspection.Views.AdminDashboardView"
    x:DataType="vm:AdminDashboardViewModel"
    Background="#F3F6FA">

    <UserControl.Styles>

        <!-- ========================================
             Summary Card
             ======================================== -->

        <Style Selector="Border.summaryCard">
            <Setter
                Property="Padding"
                Value="20" />

            <Setter
                Property="Background"
                Value="#FFFFFF" />

            <Setter
                Property="BorderBrush"
                Value="#E2E8F0" />

            <Setter
                Property="BorderThickness"
                Value="1" />

            <Setter
                Property="CornerRadius"
                Value="12" />

            <Setter
                Property="BoxShadow"
                Value="0 4 14 0 #160F172A" />
        </Style>


        <!-- ========================================
             Count
             ======================================== -->

        <Style Selector="TextBlock.summaryCount">
            <Setter
                Property="FontSize"
                Value="34" />

            <Setter
                Property="FontWeight"
                Value="Bold" />

            <Setter
                Property="Foreground"
                Value="#0F172A" />
        </Style>


        <!-- ========================================
             Card Title
             ======================================== -->

        <Style Selector="TextBlock.summaryTitle">
            <Setter
                Property="FontSize"
                Value="14" />

            <Setter
                Property="Foreground"
                Value="#64748B" />

            <Setter
                Property="FontWeight"
                Value="SemiBold" />
        </Style>

    </UserControl.Styles>


    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">

        <StackPanel
            Margin="28"
            Spacing="22">


            <!-- ========================================
                 Header
                 ======================================== -->

            <Grid
                ColumnDefinitions="*,Auto">

                <StackPanel
                    Grid.Column="0"
                    Spacing="5">

                    <TextBlock
                        Text="保全責任者"
                        FontSize="28"
                        FontWeight="Bold"
                        Foreground="#0F172A" />

                    <TextBlock
                        Text="{Binding WelcomeMessage}"
                        FontSize="14"
                        Foreground="#64748B" />

                </StackPanel>


                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">

                    <Border
                        Padding="14,8"
                        Background="#DBEAFE"
                        CornerRadius="8">

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">

                            <TextBlock
                                Text="保全責任者"
                                Foreground="#1D4ED8"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Text="{Binding CurrentDateText}"
                                Foreground="#475569" />

                        </StackPanel>

                    </Border>


                    <Button
                        Content="再読込"
                        Command="{Binding LoadCommand}"
                        IsEnabled="{Binding !IsLoading}"
                        Padding="14,8" />

                </StackPanel>

            </Grid>


            <!-- ========================================
                 Error
                 ======================================== -->

            <Border
                IsVisible="{Binding HasError}"
                Padding="14"
                CornerRadius="8"
                Background="#FEE2E2">

                <TextBlock
                    Text="{Binding ErrorMessage}"
                    Foreground="#B91C1C"
                    TextWrapping="Wrap" />

            </Border>


            <!-- ========================================
                 Section Title
                 ======================================== -->

            <TextBlock
                Text="本日の状況"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="#0F172A" />


            <!-- ========================================
                 Summary Cards
                 ======================================== -->

            <Grid
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="16"
                RowSpacing="16">


                <!-- 本日の点検予定 -->

                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Classes="summaryCard">

                    <Grid
                        RowDefinitions="Auto,Auto,Auto"
                        RowSpacing="10">

                        <TextBlock
                            Grid.Row="0"
                            Classes="summaryTitle"
                            Text="本日の点検予定" />

                        <StackPanel
                            Grid.Row="1"
                            Orientation="Horizontal"
                            Spacing="6">

                            <TextBlock
                                Classes="summaryCount"
                                Text="{Binding TodayInspectionCount}" />

                            <TextBlock
                                Text="件"
                                FontSize="16"
                                Foreground="#64748B"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,5" />

                        </StackPanel>

                        <Button
                            Grid.Row="2"
                            Content="点検実施状況を開く"
                            Command="{Binding OpenInspectionStatusCommand}"
                            HorizontalAlignment="Left"
                            Padding="12,6" />

                    </Grid>

                </Border>


                <!-- 未実施 -->

                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Classes="summaryCard">

                    <Grid
                        RowDefinitions="Auto,Auto,Auto"
                        RowSpacing="10">

                        <TextBlock
                            Grid.Row="0"
                            Classes="summaryTitle"
                            Text="本日未実施" />

                        <StackPanel
                            Grid.Row="1"
                            Orientation="Horizontal"
                            Spacing="6">

                            <TextBlock
                                Classes="summaryCount"
                                Text="{Binding TodayNotStartedCount}" />

                            <TextBlock
                                Text="件"
                                FontSize="16"
                                Foreground="#64748B"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,5" />

                        </StackPanel>

                        <Button
                            Grid.Row="2"
                            Content="未実施一覧を開く"
                            Command="{Binding OpenNotStartedCommand}"
                            HorizontalAlignment="Left"
                            Padding="12,6" />

                    </Grid>

                </Border>


                <!-- 承認待ち -->

                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Classes="summaryCard">

                    <Grid
                        RowDefinitions="Auto,Auto,Auto"
                        RowSpacing="10">

                        <TextBlock
                            Grid.Row="0"
                            Classes="summaryTitle"
                            Text="承認待ち" />

                        <StackPanel
                            Grid.Row="1"
                            Orientation="Horizontal"
                            Spacing="6">

                            <TextBlock
                                Classes="summaryCount"
                                Text="{Binding ApprovalPendingCount}"
                                Foreground="#C2410C" />

                            <TextBlock
                                Text="件"
                                FontSize="16"
                                Foreground="#64748B"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,5" />

                        </StackPanel>

                        <Button
                            Grid.Row="2"
                            Content="承認待ち一覧を開く"
                            Command="{Binding OpenApprovalPendingCommand}"
                            HorizontalAlignment="Left"
                            Padding="12,6" />

                    </Grid>

                </Border>


                <!-- 異常 -->

                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Classes="summaryCard">

                    <Grid
                        RowDefinitions="Auto,Auto,Auto"
                        RowSpacing="10">

                        <TextBlock
                            Grid.Row="0"
                            Classes="summaryTitle"
                            Text="本日の異常項目" />

                        <StackPanel
                            Grid.Row="1"
                            Orientation="Horizontal"
                            Spacing="6">

                            <TextBlock
                                Classes="summaryCount"
                                Text="{Binding TodayAbnormalCount}"
                                Foreground="#B91C1C" />

                            <TextBlock
                                Text="件"
                                FontSize="16"
                                Foreground="#64748B"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,5" />

                        </StackPanel>

                        <Button
                            Grid.Row="2"
                            Content="異常一覧を開く"
                            Command="{Binding OpenAbnormalListCommand}"
                            HorizontalAlignment="Left"
                            Padding="12,6" />

                    </Grid>

                </Border>

            </Grid>


            <!-- ========================================
                 Progress
                 ======================================== -->

            <Border
                Classes="summaryCard">

                <StackPanel
                    Spacing="14">

                    <Grid
                        ColumnDefinitions="*,Auto">

                        <StackPanel
                            Grid.Column="0"
                            Spacing="4">

                            <TextBlock
                                Text="本日の点検進捗"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="#0F172A" />

                            <TextBlock
                                Text="{Binding TodaySummaryText}"
                                FontSize="14"
                                Foreground="#64748B" />

                        </StackPanel>


                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding CompletionRateText}"
                            FontSize="26"
                            FontWeight="Bold"
                            Foreground="#1D4ED8"
                            VerticalAlignment="Center" />

                    </Grid>


                    <ProgressBar
                        Minimum="0"
                        Maximum="100"
                        Value="{Binding CompletionRate}"
                        Height="10" />


                    <Grid
                        ColumnDefinitions="*,*">

                        <StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="6">

                            <TextBlock
                                Text="完了"
                                Foreground="#64748B" />

                            <TextBlock
                                Text="{Binding TodayCompletedCount}"
                                FontWeight="Bold"
                                Foreground="#15803D" />

                            <TextBlock
                                Text="件"
                                Foreground="#64748B" />

                        </StackPanel>


                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="6">

                            <TextBlock
                                Text="未実施"
                                Foreground="#64748B" />

                            <TextBlock
                                Text="{Binding TodayNotStartedCount}"
                                FontWeight="Bold"
                                Foreground="#B45309" />

                            <TextBlock
                                Text="件"
                                Foreground="#64748B" />

                        </StackPanel>

                    </Grid>

                </StackPanel>

            </Border>


            <!-- ========================================
                 Loading
                 ======================================== -->

            <StackPanel
                IsVisible="{Binding IsLoading}"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="10">

                <ProgressBar
                    Width="160"
                    Height="6"
                    IsIndeterminate="True" />

                <TextBlock
                    Text="最新状況を取得しています..."
                    Foreground="#64748B"
                    VerticalAlignment="Center" />

            </StackPanel>

        </StackPanel>

    </ScrollViewer>

</UserControl>