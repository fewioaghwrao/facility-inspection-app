<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FacilityInspection.ViewModels"
    x:Class="FacilityInspection.Views.MemberDashboardView"
    x:DataType="vm:MemberDashboardViewModel">

    <ScrollViewer>
        <StackPanel
            Margin="32"
            Spacing="24">

            <!-- タイトル -->
            <StackPanel Spacing="6">
                <TextBlock
                    Text="{Binding Title}"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="#0F172A" />

                <TextBlock
                    Text="{Binding Description}"
                    FontSize="14"
                    Foreground="#64748B" />
            </StackPanel>

            <!-- エラーメッセージ -->
            <Border
                IsVisible="{Binding HasError}"
                Padding="12"
                Background="#FEF2F2"
                BorderBrush="#FECACA"
                BorderThickness="1"
                CornerRadius="10">
                <TextBlock
                    Text="{Binding ErrorMessage}"
                    Foreground="#B91C1C"
                    FontSize="13"
                    TextWrapping="Wrap" />
            </Border>

            <!-- 点検カレンダー本体 -->
            <Border
                Padding="24"
                CornerRadius="16"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1">

                <StackPanel Spacing="20">

                    <!-- 見出し -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="担当点検カレンダー"
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="#0F172A" />

                            <TextBlock
                                Text="自分に割り当てられている点検予定のみ表示します。"
                                FontSize="13"
                                Foreground="#64748B" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Content="再読込"
                            Command="{Binding RefreshCommand}"
                            MinWidth="96"
                            Height="36"
                            Padding="16,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
                    </Grid>

                    <!-- カレンダーと予定一覧 -->
                    <Grid
                        ColumnDefinitions="1.05*,1*"
                        ColumnSpacing="20">

                        <!-- 左：カレンダー -->
                        <Border
                            Grid.Column="0"
                            Padding="20"
                            CornerRadius="12"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1">

                            <StackPanel Spacing="16">

                                <!-- カレンダーヘッダー -->
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                    <Button
                                        Grid.Column="0"
                                        Content="‹ 前月"
                                        Command="{Binding PreviousMonthCommand}"
                                        MinWidth="88"
                                        Height="40"
                                        Padding="14,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />

                                    <Button
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        Content="今日"
                                        Command="{Binding GoToTodayCommand}"
                                        MinWidth="72"
                                        Height="40"
                                        Padding="14,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />

                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding MonthTitle}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Foreground="#0F172A" />

                                    <Button
                                        Grid.Column="3"
                                        Content="次月 ›"
                                        Command="{Binding NextMonthCommand}"
                                        MinWidth="88"
                                        Height="40"
                                        Padding="14,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center" />
                                </Grid>

                                <!-- 曜日 -->
                                <Grid ColumnDefinitions="*,*,*,*,*,*,*">
                                    <TextBlock Grid.Column="0" Text="日" HorizontalAlignment="Center" Foreground="#DC2626" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="月" HorizontalAlignment="Center" Foreground="#475569" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="火" HorizontalAlignment="Center" Foreground="#475569" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="水" HorizontalAlignment="Center" Foreground="#475569" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="木" HorizontalAlignment="Center" Foreground="#475569" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="5" Text="金" HorizontalAlignment="Center" Foreground="#475569" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="6" Text="土" HorizontalAlignment="Center" Foreground="#2563EB" FontWeight="SemiBold" />
                                </Grid>

                                <!-- 日付グリッド -->
<ItemsControl ItemsSource="{Binding CalendarDays}">
    <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
            <UniformGrid
                Columns="7"
                Rows="6" />
        </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>

    <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:CalendarDayViewModel">

            <Button
                Command="{Binding SelectCommand}"
                Margin="3"
                Padding="4"
                MinHeight="54"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Background="{Binding BackgroundColor}"
                BorderBrush="{Binding BorderColor}"
                BorderThickness="1"
                CornerRadius="8">

                <Grid
                    RowDefinitions="Auto,*,Auto">

                    <!-- 日付 -->
                    <TextBlock
                        Grid.Row="0"
                        Text="{Binding DayNumber}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{Binding DayForeground}" />

                    <!-- 点検件数 -->
                    <TextBlock
                        Grid.Row="2"
                        IsVisible="{Binding HasSchedules}"
                        Text="{Binding ScheduleCountText}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="10"
                        Foreground="#64748B" />

                </Grid>

            </Button>

        </DataTemplate>
    </ItemsControl.ItemTemplate>
</ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 右：選択日の予定一覧 -->
                        <Border
                            Grid.Column="1"
                            Padding="20"
                            CornerRadius="12"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1">

                            <StackPanel Spacing="16">

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        Text="{Binding SelectedDateTitle}"
                                        FontSize="22"
                                        FontWeight="Bold"
                                        Foreground="#0F172A" />

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding SelectedDayScheduleCountText}"
                                        VerticalAlignment="Center"
                                        Foreground="#64748B"
                                        FontSize="13" />
                                </Grid>

                                <TextBlock
                                    IsVisible="{Binding IsSelectedDayEmpty}"
                                    Text="この日の点検予定はありません。"
                                    FontSize="14"
                                    Foreground="#64748B" />

                                <ItemsControl ItemsSource="{Binding SelectedDaySchedules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="0,0,0,12"
                                                Padding="16"
                                                Background="#FFFFFF"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="1"
                                                CornerRadius="12">

                                                <StackPanel Spacing="10">

                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock
                                                            Text="{Binding LocationDisplay}"
                                                            FontWeight="SemiBold"
                                                            Foreground="#475569" />

                                                        <Border
                                                            Grid.Column="1"
                                                            Padding="10,4"
                                                            Background="{Binding StatusBackground}"
                                                            CornerRadius="999">
                                                            <TextBlock
                                                                Text="{Binding StatusText}"
                                                                Foreground="{Binding StatusForeground}"
                                                                FontSize="12"
                                                                FontWeight="SemiBold" />
                                                        </Border>
                                                    </Grid>

                                                    <TextBlock
                                                        Text="{Binding EquipmentCode}"
                                                        FontSize="22"
                                                        FontWeight="Bold"
                                                        Foreground="#1D4ED8" />

                                                    <TextBlock
                                                        Text="{Binding EquipmentName}"
                                                        FontSize="15"
                                                        FontWeight="SemiBold"
                                                        Foreground="#0F172A" />

                                                    <TextBlock
                                                        Text="{Binding TemplateDisplay}"
                                                        FontSize="13"
                                                        Foreground="#64748B" />

                                                    <TextBlock
                                                        Text="{Binding NotesDisplay}"
                                                        FontSize="13"
                                                        Foreground="#64748B"
                                                        TextWrapping="Wrap" />

                                                    <!-- ボタン崩れ対策 -->
                                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                                        <Border
                                                            Grid.Column="0"
                                                            IsVisible="False" />

                                                        <Button
                                                            Grid.Column="1"
                                                            Content="{Binding ActionButtonText}"
                                                            Command="{Binding StartInspectionCommand}"
                                                            MinWidth="120"
                                                            Height="40"
                                                            Padding="18,0"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Background="#2563EB"
                                                            Foreground="White" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>