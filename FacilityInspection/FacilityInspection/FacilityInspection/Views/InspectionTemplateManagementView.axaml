<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FacilityInspection.ViewModels"
    x:Class="FacilityInspection.Views.InspectionTemplateManagementView"
    x:DataType="vm:InspectionTemplateManagementViewModel"
    Background="#F3F6FA">

    <Grid>

        <!-- 通常画面 -->
        <Grid
            Margin="28"
            RowDefinitions="Auto,Auto,*"
            RowSpacing="16">

            <!-- ヘッダー -->
            <Grid
                Grid.Row="0"
                ColumnDefinitions="*,Auto">

                <StackPanel
                    Grid.Column="0"
                    Spacing="5">

                    <TextBlock
                        Text="点検票テンプレート管理"
                        FontSize="28"
                        FontWeight="Bold"
                        Foreground="#0F172A" />

                    <TextBlock
                        Text="設備種別ごとの点検項目と入力方式を管理します。"
                        FontSize="14"
                        Foreground="#64748B" />

                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">

                    <Button
                        MinWidth="100"
                        MinHeight="42"
                        Content="再読込"
                        Command="{Binding LoadTemplatesCommand}"
                        HorizontalContentAlignment="Center"
                        Background="#FFFFFF"
                        Foreground="#334155"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="8" />

                    <Button
                        MinWidth="120"
                        MinHeight="42"
                        Content="新規作成"
                        HorizontalContentAlignment="Center"
                        Background="#2563EB"
                        Foreground="#FFFFFF"
                        BorderBrush="#2563EB"
                        BorderThickness="1"
                        CornerRadius="8" />

                </StackPanel>

            </Grid>

            <!-- 状態表示 -->
            <StackPanel
                Grid.Row="1"
                Spacing="8">

                <TextBlock
                    Text="読み込み中..."
                    IsVisible="{Binding IsLoading}"
                    FontSize="13"
                    Foreground="#2563EB" />

                <Border
                    IsVisible="{Binding HasError}"
                    Padding="12"
                    Background="#FEF2F2"
                    BorderBrush="#FCA5A5"
                    BorderThickness="1"
                    CornerRadius="8">

                    <TextBlock
                        Text="{Binding ErrorMessage}"
                        TextWrapping="Wrap"
                        Foreground="#B91C1C" />

                </Border>

                <Border
                    IsVisible="{Binding HasOperationMessage}"
                    Padding="12"
                    Background="#F0FDF4"
                    BorderBrush="#86EFAC"
                    BorderThickness="1"
                    CornerRadius="8">

                    <TextBlock
                        Text="{Binding OperationMessage}"
                        TextWrapping="Wrap"
                        Foreground="#166534" />

                </Border>

            </StackPanel>

            <!-- テンプレート一覧・詳細 -->
            <Grid
                Grid.Row="2"
                ColumnDefinitions="300,*"
                ColumnSpacing="18">

                <!-- 左側：テンプレート一覧 -->
                <Border
                    Grid.Column="0"
                    Padding="16"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12">

                    <Grid RowDefinitions="Auto,*">

                        <TextBlock
                            Grid.Row="0"
                            Margin="4,0,4,12"
                            Text="テンプレート一覧"
                            FontSize="17"
                            FontWeight="Bold"
                            Foreground="#0F172A" />

                        <Grid Grid.Row="1">

                            <ListBox
                                ItemsSource="{Binding Templates}"
                                SelectedItem="{Binding SelectedTemplate}">

                                <ListBox.ItemTemplate>

                                    <DataTemplate
                                        x:DataType="vm:InspectionTemplateListItemViewModel">

                                        <Border
                                            Padding="12"
                                            Margin="0,3"
                                            Background="#F8FAFC"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="8">

                                            <StackPanel Spacing="5">

                                                <TextBlock
                                                    Text="{Binding EquipmentTypeName}"
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    Foreground="#0F172A" />

                                                <TextBlock
                                                    Text="{Binding Name}"
                                                    FontSize="12"
                                                    TextWrapping="Wrap"
                                                    Foreground="#475569" />

                                                <StackPanel
                                                    Orientation="Horizontal"
                                                    Spacing="8">

                                                    <TextBlock
                                                        Text="{Binding VersionText}"
                                                        FontSize="11"
                                                        Foreground="#64748B" />

                                                    <TextBlock
                                                        Text="{Binding StatusText}"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="#15803D" />

                                                </StackPanel>

                                            </StackPanel>

                                        </Border>

                                    </DataTemplate>

                                </ListBox.ItemTemplate>

                            </ListBox>

                            <TextBlock
                                IsVisible="{Binding IsEmpty}"
                                Text="点検票テンプレートが登録されていません。"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                FontSize="13"
                                Foreground="#64748B" />

                        </Grid>

                    </Grid>

                </Border>

                <!-- 右側：選択中テンプレート -->
                <!-- DataContextはSelectedTemplateへ変更しない -->
                <Border
                    Grid.Column="1"
                    Padding="22"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12">

                    <Grid RowDefinitions="Auto,Auto,*">

                        <!-- テンプレート情報 -->
                        <Grid
                            Grid.Row="0"
                            ColumnDefinitions="*,Auto">

                            <StackPanel
                                Grid.Column="0"
                                Spacing="5">

                                <TextBlock
                                    Text="{Binding SelectedTemplate.Name}"
                                    FontSize="21"
                                    FontWeight="Bold"
                                    Foreground="#0F172A" />

                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="12">

                                    <TextBlock
                                        Text="{Binding SelectedTemplate.EquipmentTypeName}"
                                        Foreground="#475569" />

                                    <TextBlock
                                        Text="{Binding SelectedTemplate.VersionText}"
                                        Foreground="#64748B" />

                                    <TextBlock
                                        Text="{Binding SelectedTemplate.StatusText}"
                                        FontWeight="SemiBold"
                                        Foreground="#15803D" />

                                </StackPanel>

                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8">

                                <Button
                                    MinWidth="80"
                                    MinHeight="38"
                                    Content="編集"
                                    Command="{Binding OpenEditDialogCommand}"
                                    HorizontalContentAlignment="Center"
                                    Background="#FFFFFF"
                                    Foreground="#334155"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    CornerRadius="7" />

                                <Button
                                    MinWidth="80"
                                    MinHeight="38"
                                    Content="{Binding SelectedTemplate.ActiveToggleText}"
                                    Command="{Binding ToggleActiveCommand}"
                                    HorizontalContentAlignment="Center"
                                    Background="#FFFFFF"
                                    Foreground="#B91C1C"
                                    BorderBrush="#FCA5A5"
                                    BorderThickness="1"
                                    CornerRadius="7" />

                            </StackPanel>

                        </Grid>

                        <!-- 点検項目ヘッダー -->
                        <Grid
                            Grid.Row="1"
                            Margin="0,24,0,8"
                            ColumnDefinitions="48,*,130,90,70">

                            <TextBlock
                                Grid.Column="0"
                                Text="順番"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#64748B" />

                            <TextBlock
                                Grid.Column="1"
                                Text="点検項目"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#64748B" />

                            <TextBlock
                                Grid.Column="2"
                                Text="入力方式"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#64748B" />

                            <TextBlock
                                Grid.Column="3"
                                Text="単位"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#64748B" />

                            <TextBlock
                                Grid.Column="4"
                                Text="必須"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#64748B" />

                        </Grid>

                        <!-- 点検項目一覧 -->
                        <ScrollViewer
                            Grid.Row="2"
                            VerticalScrollBarVisibility="Auto">

                            <ItemsControl
                                ItemsSource="{Binding SelectedTemplate.Items}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate
                                        x:DataType="vm:InspectionTemplateItemRowViewModel">

                                        <Border
                                            Padding="12"
                                            Margin="0,3"
                                            Background="#F8FAFC"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="7">

                                            <Grid
                                                ColumnDefinitions="48,*,130,90,70">

                                                <TextBlock
                                                    Grid.Column="0"
                                                    Text="{Binding DisplayOrder}"
                                                    VerticalAlignment="Center"
                                                    Foreground="#475569" />

                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{Binding ItemName}"
                                                    VerticalAlignment="Center"
                                                    TextWrapping="Wrap"
                                                    Foreground="#0F172A" />

                                                <TextBlock
                                                    Grid.Column="2"
                                                    Text="{Binding InputTypeName}"
                                                    VerticalAlignment="Center"
                                                    Foreground="#475569" />

                                                <TextBlock
                                                    Grid.Column="3"
                                                    Text="{Binding UnitText}"
                                                    VerticalAlignment="Center"
                                                    Foreground="#475569" />

                                                <TextBlock
                                                    Grid.Column="4"
                                                    Text="{Binding RequiredText}"
                                                    VerticalAlignment="Center"
                                                    Foreground="#2563EB" />

                                            </Grid>

                                        </Border>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </ScrollViewer>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

        <!-- 編集ダイアログ -->
        <Border
            ZIndex="100"
            IsVisible="{Binding IsEditDialogOpen}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="#990F172A">

            <Border
                MaxWidth="1050"
                MaxHeight="720"
                Margin="24"
                Padding="24"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="14"
                BoxShadow="0 16 40 0 #59000000">

                <Grid
                    RowDefinitions="Auto,Auto,Auto,*,Auto"
                    RowSpacing="16">

                    <!-- ダイアログヘッダー -->
                    <Grid
                        Grid.Row="0"
                        ColumnDefinitions="*,Auto">

                        <StackPanel Spacing="4">

                            <TextBlock
                                Text="点検票テンプレート編集"
                                FontSize="22"
                                FontWeight="Bold"
                                Foreground="#0F172A" />

                            <TextBlock
                                Text="テンプレート名と各点検項目を編集します。"
                                FontSize="13"
                                Foreground="#64748B" />

                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Width="36"
                            Height="36"
                            Content="×"
                            Command="{Binding CancelEditCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="20"
                            Foreground="#64748B" />

                    </Grid>

                    <!-- テンプレート名 -->
                    <StackPanel
                        Grid.Row="1"
                        Spacing="6">

                        <TextBlock
                            Text="テンプレート名"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#334155" />

                        <TextBox
                            Text="{Binding EditTemplateName, Mode=TwoWay}"
                            Watermark="テンプレート名を入力"
                            MinHeight="40" />

                    </StackPanel>

                    <!-- 編集エラー -->
                    <Border
                        Grid.Row="2"
                        IsVisible="{Binding HasEditError}"
                        Padding="12"
                        Background="#FEF2F2"
                        BorderBrush="#FCA5A5"
                        BorderThickness="1"
                        CornerRadius="8">

                        <TextBlock
                            Text="{Binding EditErrorMessage}"
                            TextWrapping="Wrap"
                            Foreground="#B91C1C" />

                    </Border>

                    <!-- 点検項目編集一覧 -->
                    <ScrollViewer
                        Grid.Row="3"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">

                        <StackPanel
                            MinWidth="920"
                            Spacing="8">

                            <!-- 列ヘッダー -->
                            <Grid
                                ColumnDefinitions="55,2*,145,90,105,105,65,65"
                                ColumnSpacing="8">

                                <TextBlock
                                    Grid.Column="0"
                                    Text="順番"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#64748B" />

                                <TextBlock
                                    Grid.Column="1"
                                    Text="点検項目"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#64748B" />

                                <TextBlock
                                    Grid.Column="2"
                                    Text="入力方式"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#64748B" />

                                <TextBlock
                                    Grid.Column="3"
                                    Text="単位"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#64748B" />

                                <TextBlock
                                    Grid.Column="4"
                                    Text="基準下限"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#64748B" />

                                <TextBlock
                                    Grid.Column="5"
                                    Text="基準上限"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#64748B" />

                                <TextBlock
                                    Grid.Column="6"
                                    Text="必須"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#64748B" />

                                <TextBlock
                                    Grid.Column="7"
                                    Text="有効"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#64748B" />

                            </Grid>

                            <ItemsControl
                                ItemsSource="{Binding EditingItems}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate
                                        x:DataType="vm:InspectionTemplateItemEditorViewModel">

                                        <Border
                                            Padding="10"
                                            Background="#F8FAFC"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="8">

                                            <Grid
                                                ColumnDefinitions="55,2*,145,90,105,105,65,65"
                                                ColumnSpacing="8">

                                                <NumericUpDown
                                                    Grid.Column="0"
                                                    Value="{Binding DisplayOrder, Mode=TwoWay}"
                                                    Minimum="1"
                                                    FormatString="0" />

                                                <TextBox
                                                    Grid.Column="1"
                                                    Text="{Binding ItemName, Mode=TwoWay}"
                                                    Watermark="点検項目名" />

                                                <ComboBox
                                                    Grid.Column="2"
                                                    ItemsSource="{Binding InputTypeChoices}"
                                                    SelectedItem="{Binding InputTypeName, Mode=TwoWay}" />

                                                <TextBox
                                                    Grid.Column="3"
                                                    Text="{Binding Unit, Mode=TwoWay}"
                                                    Watermark="MPa" />

                                                <TextBox
                                                    Grid.Column="4"
                                                    Text="{Binding MinimumValue, Mode=TwoWay}"
                                                    Watermark="下限" />

                                                <TextBox
                                                    Grid.Column="5"
                                                    Text="{Binding MaximumValue, Mode=TwoWay}"
                                                    Watermark="上限" />

                                                <CheckBox
                                                    Grid.Column="6"
                                                    IsChecked="{Binding IsRequired, Mode=TwoWay}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />

                                                <CheckBox
                                                    Grid.Column="7"
                                                    IsChecked="{Binding IsActive, Mode=TwoWay}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />

                                            </Grid>

                                        </Border>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </StackPanel>

                    </ScrollViewer>

                    <!-- 操作ボタン -->
                    <Grid
                        Grid.Row="4"
                        ColumnDefinitions="*,Auto,Auto"
                        ColumnSpacing="10">

                        <TextBlock
                            Grid.Column="0"
                            Text="変更内容は保存ボタンを押すまで反映されません。"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#64748B" />

                        <Button
                            Grid.Column="1"
                            MinWidth="100"
                            MinHeight="42"
                            Content="キャンセル"
                            Command="{Binding CancelEditCommand}"
                            HorizontalContentAlignment="Center"
                            Background="#FFFFFF"
                            Foreground="#334155"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="8" />

                        <Button
                            Grid.Column="2"
                            MinWidth="100"
                            MinHeight="42"
                            Content="保存"
                            Command="{Binding SaveEditCommand}"
                            HorizontalContentAlignment="Center"
                            Background="#2563EB"
                            Foreground="#FFFFFF"
                            BorderBrush="#2563EB"
                            BorderThickness="1"
                            CornerRadius="8" />

                    </Grid>

                </Grid>

            </Border>

        </Border>

    </Grid>

</UserControl>