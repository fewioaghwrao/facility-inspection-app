<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FacilityInspection.ViewModels"
    xmlns:equipment="using:FacilityInspection.Domain.Equipments"
    x:Class="FacilityInspection.Views.MainView"
    x:DataType="vm:MainViewModel">

    <ScrollViewer>
        <StackPanel
            Margin="24"
            Spacing="16">

            <!-- 画面タイトル -->
            <StackPanel Spacing="4">
                <TextBlock
                    Text="設備台帳"
                    FontSize="28"
                    FontWeight="Bold" />

                <TextBlock
                    Text="工場ユーティリティ・付帯設備の登録と管理"
                    FontSize="15"
                    Opacity="0.75" />
            </StackPanel>

            <!-- 現在は初期Locationへ固定登録 -->
            <Border
                Padding="12"
                CornerRadius="6"
                BorderBrush="#30000000"
                BorderThickness="1">

                <StackPanel Spacing="4">
                    <TextBlock
                        Text="登録先"
                        FontWeight="Bold" />

                    <TextBlock
                        Text="第1工場 / 1F / コンプレッサー室"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="※工場・設置場所の選択機能は次フェーズで追加予定"
                        FontSize="12"
                        Opacity="0.7"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 設備登録フォーム -->
            <Border
                Padding="16"
                CornerRadius="8"
                BorderBrush="#30000000"
                BorderThickness="1">

                <StackPanel Spacing="12">

                    <TextBlock
                        Text="設備を登録"
                        FontSize="20"
                        FontWeight="Bold" />

                    <StackPanel Spacing="4">
                        <TextBlock
                            Text="設備コード"
                            FontWeight="SemiBold" />

                        <TextBox
                            Text="{Binding NewEquipmentCode, Mode=TwoWay}"
                            Watermark="例：EQ-001"
                            MaxLength="30" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock
                            Text="設備名"
                            FontWeight="SemiBold" />

                        <TextBox
                            Text="{Binding NewEquipmentName, Mode=TwoWay}"
                            Watermark="例：第1エアコンプレッサー"
                            MaxLength="100" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock
                            Text="設備種別"
                            FontWeight="SemiBold" />

                        <ComboBox
                            ItemsSource="{Binding EquipmentTypes}"
                            SelectedItem="{Binding SelectedEquipmentType, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8">

                        <Button
                            Content="設備を登録"
                            Command="{Binding SaveCommand}"
                            MinWidth="120" />

                        <Button
                            Content="再読込"
                            Command="{Binding ReloadCommand}"
                            MinWidth="90" />
                    </StackPanel>

                    <TextBlock
                        Text="{Binding StatusMessage}"
                        TextWrapping="Wrap"
                        FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <!-- 設備一覧 -->
            <StackPanel Spacing="10">

                <TextBlock
                    Text="登録済み設備"
                    FontSize="20"
                    FontWeight="Bold" />

                <ItemsControl ItemsSource="{Binding Equipments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="equipment:Equipment">

                            <Border
                                Margin="0,0,0,8"
                                Padding="14"
                                CornerRadius="8"
                                BorderBrush="#30000000"
                                BorderThickness="1">

                                <Grid
                                    ColumnDefinitions="Auto,*"
                                    RowDefinitions="Auto,Auto,Auto,Auto"
                                    ColumnSpacing="12"
                                    RowSpacing="4">

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="設備名"
                                        FontSize="12"
                                        Opacity="0.65" />

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Text="{Binding Name}"
                                        FontWeight="Bold"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Text="設備コード"
                                        FontSize="12"
                                        Opacity="0.65" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="{Binding EquipmentCode}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Text="設備種別"
                                        FontSize="12"
                                        Opacity="0.65" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Text="{Binding EquipmentType}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Text="稼働状態"
                                        FontSize="12"
                                        Opacity="0.65" />

                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Text="{Binding Status}"
                                        TextWrapping="Wrap" />

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- 開発用情報 -->
            <Expander Header="開発用情報">

                <Border
                    Margin="0,8,0,0"
                    Padding="12"
                    CornerRadius="6"
                    Background="#10000000">

                    <StackPanel Spacing="4">
                        <TextBlock
                            Text="SQLite保存先"
                            FontWeight="Bold" />

                        <TextBlock
                            Text="{Binding DatabasePath}"
                            TextWrapping="Wrap"
                            FontSize="12" />
                    </StackPanel>
                </Border>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>