<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FacilityInspection.ViewModels"
    x:Class="FacilityInspection.Views.MemberShellView"
    x:DataType="vm:MemberShellViewModel"
    Background="#F3F6FA">

    <UserControl.Styles>

        <!-- ========================================
             Navigation Button
             ======================================== -->

        <Style Selector="Button.navButton">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter
                Property="HorizontalContentAlignment"
                Value="Stretch" />
        </Style>

        <Style Selector="Button.navButton:pointerover">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#0F172A" />
        </Style>

        <!-- 選択中 -->
        <Style Selector="Button.navButton.selected">
            <Setter Property="Background" Value="#E8F0FE" />
            <Setter Property="Foreground" Value="#1D4ED8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>


        <!-- ========================================
             Navigation Icon
             ======================================== -->

        <Style Selector="Border.navIcon">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="#F1F5F9" />
        </Style>


        <!-- ========================================
             Section Label
             ======================================== -->

        <Style Selector="TextBlock.sectionLabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="Margin" Value="10,18,0,6" />
        </Style>

    </UserControl.Styles>


    <!-- ============================================
         Root
         AdminShellView と同じ
         Sidebar + Content の2カラム
         ============================================ -->

    <Grid ColumnDefinitions="280,*">


        <!-- ========================================
             Sidebar
             ======================================== -->

        <Border
            Grid.Column="0"
            Background="#FFFFFF"
            BorderBrush="#E2E8F0"
            BorderThickness="0,0,1,0">

            <Grid
                Margin="16"
                RowDefinitions="Auto,Auto,*,Auto">


                <!-- ========================================
                     Application Header
                     ======================================== -->

                <StackPanel
                    Grid.Row="0"
                    Margin="4,8,4,18"
                    Spacing="14">

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="12">

                        <Border
                            Width="44"
                            Height="44"
                            CornerRadius="10"
                            ClipToBounds="True"
                            Background="#EFF6FF">

                            <Image
                                Source="/Assets/facility-inspection.png"
                                Stretch="UniformToFill" />

                        </Border>


                        <StackPanel
                            VerticalAlignment="Center"
                            Spacing="2">

                            <TextBlock
                                Text="設備点検・保守記録"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="#0F172A" />

                            <TextBlock
                                Text="点検担当者メニュー"
                                FontSize="11"
                                Foreground="#94A3B8" />

                        </StackPanel>

                    </StackPanel>

                </StackPanel>


                <!-- ========================================
                     Current User
                     ======================================== -->

                <Border
                    Grid.Row="1"
                    Padding="12"
                    Margin="0,0,0,8"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10">

                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="10">

                        <Border
                            Grid.Column="0"
                            Width="36"
                            Height="36"
                            CornerRadius="18"
                            Background="#DBEAFE">

                            <TextBlock
                                Text="点"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="#1D4ED8" />

                        </Border>


                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="1">

                            <TextBlock
                                Text="{Binding OperatorName}"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#0F172A"
                                TextTrimming="CharacterEllipsis" />

                            <TextBlock
                                Text="設備点検担当者"
                                FontSize="11"
                                Foreground="#64748B" />

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- ========================================
                     Navigation
                     ======================================== -->

                <ScrollViewer
                    Grid.Row="2"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>


                        <!-- ====================================
                             Inspection Schedule
                             ==================================== -->

                        <TextBlock
                            Classes="sectionLabel"
                            Text="点検" />


                        <Button
                            Classes="navButton"
                            Classes.selected="{Binding IsDashboardSelected}"
                            Command="{Binding OpenDashboardCommand}">

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="11">

                                <Border Classes="navIcon">
                                    <TextBlock
                                        Text="▦"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="14" />
                                </Border>

                                <TextBlock
                                    Text="点検予定"
                                    VerticalAlignment="Center" />

                            </StackPanel>

                        </Button>


                        <!-- ====================================
                             Inspection List
                             ==================================== -->

                        <Button
                            Classes="navButton"
                            Classes.selected="{Binding IsInspectionListSelected}"
                            Command="{Binding OpenInspectionListCommand}">

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="11">

                                <Border Classes="navIcon">
                                    <TextBlock
                                        Text="✓"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="15" />
                                </Border>

                                <TextBlock
                                    Text="点検一覧"
                                    VerticalAlignment="Center" />

                            </StackPanel>

                        </Button>

                    </StackPanel>

                </ScrollViewer>


                <!-- ========================================
                     Logout
                     ======================================== -->

                <Border
                    Grid.Row="3"
                    Margin="0,12,0,4"
                    Padding="0,12,0,0"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,1,0,0">

                    <Button
                        Classes="navButton"
                        Command="{Binding OpenLogoutDialogCommand}">

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="11">

                            <Border
                                Classes="navIcon"
                                Background="#FEF2F2">

                                <TextBlock
                                    Text="⎋"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Foreground="#DC2626" />

                            </Border>

                            <TextBlock
                                Text="ログアウト"
                                VerticalAlignment="Center"
                                Foreground="#B91C1C" />

                        </StackPanel>

                    </Button>

                </Border>

            </Grid>

        </Border>


        <!-- ========================================
             Main Content
             ======================================== -->

        <Border
            Grid.Column="1"
            Background="#F3F6FA">

            <ContentControl
                Content="{Binding CurrentContent}" />

        </Border>


        <!-- ========================================
             Logout Dialog
             AdminShellView と同じく最後に配置
             ======================================== -->

        <Border
            Grid.Column="0"
            Grid.ColumnSpan="2"
            IsVisible="{Binding IsLogoutDialogOpen}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="#990F172A">

            <Border
                Width="420"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="16"
                BoxShadow="0 16 40 0 #59000000">

                <StackPanel Spacing="20">


                    <Border
                        Width="52"
                        Height="52"
                        HorizontalAlignment="Center"
                        Background="#FEE2E2"
                        CornerRadius="26">

                        <TextBlock
                            Text="⎋"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="25"
                            FontWeight="Bold"
                            Foreground="#DC2626" />

                    </Border>


                    <StackPanel Spacing="8">

                        <TextBlock
                            Text="ログアウトしますか？"
                            HorizontalAlignment="Center"
                            FontSize="21"
                            FontWeight="Bold"
                            Foreground="#0F172A" />

                        <TextBlock
                            Text="現在のログイン状態を終了し、ログイン画面に戻ります。"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            FontSize="13"
                            Foreground="#64748B" />

                    </StackPanel>


                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="12">

                        <Button
                            Grid.Column="0"
                            Content="キャンセル"
                            Command="{Binding CancelLogoutCommand}"
                            MinHeight="44"
                            HorizontalContentAlignment="Center"
                            Background="#FFFFFF"
                            Foreground="#334155"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="8" />

                        <Button
                            Grid.Column="1"
                            Content="ログアウト"
                            Command="{Binding ConfirmLogoutCommand}"
                            MinHeight="44"
                            HorizontalContentAlignment="Center"
                            Background="#DC2626"
                            Foreground="#FFFFFF"
                            BorderBrush="#DC2626"
                            BorderThickness="1"
                            CornerRadius="8" />

                    </Grid>

                </StackPanel>

            </Border>

        </Border>

    </Grid>

</UserControl>
